#!/usr/bin/env bash
# Pre-commit hook: protect the frozen published artifacts and block stray
# WASM commits.
#
# Frozen (published-contract/README.md):
#   * every file pinned in published-contract/frozen.sha256 (the webapp and
#     container contracts, their parameters and ids, and wasm/v<N>/*);
#   * every file under published-contract/wasm/;
#   * every existing row of published-contract/frozen.sha256.
# A contract's or delegate's key derives from these bytes, so changing one
# moves users' data or URL to a new key. A new generation is added in a new
# published-contract/wasm/v<N+1>/ directory, with new pin rows; nothing
# existing is modified, deleted, renamed or retyped. CI enforces the same
# (scripts/check-frozen-immutable.sh).
#
# Any other .wasm file showing up in a commit is almost certainly an
# accidental `target/` or `build/` artifact that slipped past .gitignore.

set -euo pipefail

MANIFEST='published-contract/frozen.sha256'
ALLOWED_WASM='^published-contract/(web_container_contract|container)\.wasm$'

block() {
    echo ""
    echo "🚫 BLOCKED: $1"
    shift
    printf '%s\n' "$@" | sed 's/^/  /'
    echo ""
    echo "These are the exact bytes that shipped; changing them re-keys a contract or"
    echo "delegate and strands its users' data or URL. A new generation goes in a new"
    echo "published-contract/wasm/v<N>/ directory instead. To restore:"
    echo "  git restore --staged --worktree -- published-contract/"
    echo ""
    exit 1
}

if git rev-parse --verify --quiet HEAD >/dev/null; then
    frozen=$( { git show "HEAD:$MANIFEST" 2>/dev/null | awk '{print $2}'
                git ls-tree -r --name-only HEAD -- published-contract/wasm/; } | sort -u)
    changed=$(git diff --cached --no-renames --name-only --diff-filter=MDT -- published-contract/ | sort -u)
    hit=$(comm -12 <(printf '%s\n' "$frozen") <(printf '%s\n' "$changed") | sed '/^$/d')
    [ -z "$hit" ] || block "frozen artifacts are modified, deleted, renamed or retyped:" "$hit"

    if git cat-file -e "HEAD:$MANIFEST" 2>/dev/null; then
        lost=$(comm -23 <(git show "HEAD:$MANIFEST" | sort) \
                        <(git show ":$MANIFEST" 2>/dev/null | sort) | sed '/^$/d')
        [ -z "$lost" ] || block "existing rows of $MANIFEST are removed or changed:" "$lost"
    fi
fi

STRAY=$(git diff --cached --no-renames --name-only --diff-filter=ACMT -- '*.wasm' \
    | grep -vE "$ALLOWED_WASM" || true)
if [ -n "$STRAY" ]; then
    echo ""
    echo "🚫 BLOCKED: stray .wasm files are staged for commit outside published-contract/."
    echo ""
    echo "Staged stray WASM files:"
    printf '%s\n' "$STRAY" | sed 's/^/  /'
    echo ""
    echo "Everything else is a build artifact that should stay in target/ or"
    echo "build/ (ignored by git). To unstage:"
    echo "  git restore --staged <file>"
    echo ""
    exit 1
fi
exit 0
